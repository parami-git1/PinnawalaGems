# Blank reference only. Keep actual values in the existing Render service.
# Required to start the backend:
MONGO_URI=
JWT_SECRET=

# Password administrator login:
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional Google administrator login:
GOOGLE_CLIENT_ID=
ADMIN_GOOGLE_EMAILS=
ADMIN_EMAIL=

# Existing Cloudinary image storage:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Render runtime selection (set to 24 in the Render dashboard):
NODE_VERSION=

# Optional local port. Render supplies PORT automatically.
PORT=
