# Blank reference only. Keep actual values in the existing Render service.
# Required to start the backend:
MONGO_URI=
JWT_SECRET=
NODE_ENV=

# Required in production: comma-separated full frontend origins, without paths.
# Example format only: https://your-website.example
ALLOWED_ORIGINS=
# Render has one trusted reverse-proxy hop; use 0 for direct/local hosting.
TRUST_PROXY_HOPS=

# Authentication mode: mixed preserves existing password/Google methods.
# Set google for single-owner Gmail-only access, including existing JWT access.
ADMIN_AUTH_MODE=

# Email/username and password login (disabled when ADMIN_AUTH_MODE=google):
# ADMIN_USERNAME can be the administrator's email. Email comparison ignores case;
# existing non-email usernames remain case sensitive. Never commit real values.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Public Google Web OAuth client ID; no Google client secret or Gmail API needed.
GOOGLE_CLIENT_ID=
# Required sole verified @gmail.com owner in google mode. No commas or aliases.
ADMIN_GOOGLE_EMAIL=
# Legacy mixed-mode list/fallback; ignored when the singular owner is configured.
ADMIN_GOOGLE_EMAILS=
ADMIN_EMAIL=

# Existing Cloudinary image storage:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Render runtime selection (set to 24 in the Render dashboard):
NODE_VERSION=

# Optional local port. Render supplies PORT automatically.
PORT=
